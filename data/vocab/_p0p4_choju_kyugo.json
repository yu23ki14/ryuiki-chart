    "notes": [
      {
        "note_id": "n_kyugo_j2017_001",
        "table_ids": ["p2_t1", "p2_t2"],
        "kind": "survey_scope",
        "text": "＊平成29年度は鳥インフルエンザの影響で以下の期間、鳥類の受け入れを休止しました。\n鳥類の受け入れ休止期間：横浜市立動物園：2017年12月～\n川崎市立夢見ヶ崎動物公園：2018年1月～\n保全センター：2018年1月11日～2月5日",
        "page": 2,
        "blocks_timeseries": true,
        "reason": "平成29年度は鳥インフルエンザ対策のため一部施設・期間で鳥類の受け入れを休止しており、年度内の鳥類救護件数が実際の傷病鳥獣発生数を反映していない。平成29年度の鳥類件数を他年度と単純比較すると過小評価になる。"
      },
      {
        "note_id": "n_kyugo_j2017_002",
        "table_ids": ["p2_t1"],
        "kind": "definition_change",
        "text": "＊（）はへい死体で持ち込まれたもので、内数",
        "page": 1,
        "blocks_timeseries": false,
        "reason": "括弧内の数値が「持ち込み時点で死亡していた個体数」を示す内数であることの定義。全体件数の一部であり、独立した別カウントではない点に注意。"
      },
      {
        "note_id": "n_kyugo_j2017_003",
        "table_ids": ["p2_t1", "p2_t2"],
        "kind": "definition_change",
        "text": "＊各年度の3月31日時点（へい死体除く）",
        "page": 2,
        "blocks_timeseries": false,
        "reason": "放野率・死亡率等の集計基準日と、へい死体(搬入時死亡)を除く対象範囲の定義。"
      },
      {
        "note_id": "n_kyugo_j2017_004",
        "table_ids": ["p2_t1", "p2_t2"],
        "kind": "definition_change",
        "text": "＊その他は治療中・終生飼養・長期飼養に移管したものなどを含む。",
        "page": 2,
        "blocks_timeseries": false,
        "reason": "転帰区分「その他」の定義。"
      }
    ]
  },
