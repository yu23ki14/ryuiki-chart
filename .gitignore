# ---------------------------------------------------------------
# データ (data/)
# ---------------------------------------------------------------
# 収集物・中間生成物・DB は合計 14GB あり GitHub には載せない。
# すべて scripts/ のコレクタと web/scripts/ のビルダで再生成できる。
#   - data/raw, data/processed, data/dwca : scripts/c*.py が取得・整形
#   - data/db/ryuiki.sqlite, cells.sqlite : 原本。100MB 超のため別配布
# 例外は 2 つだけ。どちらも「スクリプトで再生成できない、手で育てるデータ」。
#   - data/vocab/ : LLM 抽出済みの語彙（再取得できず、436KB）
#   - data/water/ : 水道水の水源マップの原本 CSV（事業体の PDF を人と Agent が読んで作る。
#                   docs/WATER_SOURCE_MAP.md §6。PDF 自体は data/raw/water/ で管理外）
data/*
!data/vocab/
!data/water/
# Issue #29「縮小サンプル＋実行証明」の縮小サンプル。scripts/s01_build_sample.py が
# 書くテキスト（CREATE/INSERT の .sql・coverage.yaml・manifest.json・
# declaration_counts.yaml・derived_keys.yaml）で、sqlite バイナリは含まない
# （data/vocab/ と同じ流儀。docs/plans/PHASE_B_RECONCILIATION.md §5）。
!data/sample/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Node / Next.js / Cloudflare
# ---------------------------------------------------------------
# web/ 配下の node_modules, .next, .wrangler, .open-next は web/.gitignore が担当。
# ここではルートに漏れたものだけを拾う。
node_modules/
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# OS / エディタ
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------
# エージェントの作業領域
# ---------------------------------------------------------------
# サブエージェントの git worktree が .claude/worktrees/ に作られる。リポジトリの
# 中にあるため `git add -A` で index に入る事故が起きる（実際に起きた）。
.claude/

# Parquet 配布物（scripts/d01_build_dist.py の生成物。ADR-0001）
/dist/
