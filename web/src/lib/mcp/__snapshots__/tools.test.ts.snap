// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MCP ツール一覧（第1段 5 本） > 入力スキーマのスナップショット 1`] = `
[
  {
    "description": "流域カルテにどんな測定項目・水域・ゾーン・出典があるかを一覧する。まず全体像を掴むときに使う。what='variables' は測定項目（variableId を get_observations に渡す）、'waters' は水域、'zones' は Ridge to Reef ゾーン、'sources' は出典（取得日・更新方式つき）。読み方: 値は定量下限未満を value_lod（下限値で代用）と value_zero（0 で代用）の両方で返す。n_censored・n_not_detected が多い系列は下限付近の値を平均した結果なので断定しない。caveats は必ず利用者に伝える。provenance の fetched_at・update_mode・age_days から、データの新しさと更新方式を判断する（update_mode が undeclared の出典は更新方式が未宣言）。欠測を補完しない。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "返す行数の上限（既定 100、最大 500）",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "variableId": {
          "description": "what='waters' のとき、この項目のデータを持つ水域に絞る（variables の variableId）",
          "type": "string",
        },
        "what": {
          "description": "一覧する対象",
          "enum": [
            "variables",
            "waters",
            "zones",
            "sources",
          ],
          "type": "string",
        },
      },
      "required": [
        "what",
      ],
      "type": "object",
    },
    "name": "describe_catalog",
  },
  {
    "description": "語彙（測定項目・出典・生物種）を名前で検索する。変数名や種名の表記ゆれから ID（variableId・sourceId・学名）を引くときに使う。kind='variable' は測定項目、'source' は出典、'species' は出現記録のある種（和名・学名）。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "kind": {
          "description": "検索する語彙",
          "enum": [
            "variable",
            "source",
            "species",
          ],
          "type": "string",
        },
        "limit": {
          "description": "返す行数の上限（既定 100、最大 500）",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "部分一致の検索語（和名・英名・ID の一部）",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "kind",
        "query",
      ],
      "type": "object",
    },
    "name": "search_registry",
  },
  {
    "description": "ある測定項目の時系列を取る（水質・気象・水文など）。scope で水域（地点ごと）・1地点・ゾーン平均を選び、grain で粒度を選ぶ。応答は封筒（rows・coverage・provenance・caveats・excluded・cite_as）。読み方: 値は定量下限未満を value_lod（下限値で代用）と value_zero（0 で代用）の両方で返す。n_censored・n_not_detected が多い系列は下限付近の値を平均した結果なので断定しない。caveats は必ず利用者に伝える。provenance の fetched_at・update_mode・age_days から、データの新しさと更新方式を判断する（update_mode が undeclared の出典は更新方式が未宣言）。欠測を補完しない。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "from": {
          "description": "grain='day' の開始日 YYYY-MM-DD",
          "type": "string",
        },
        "grain": {
          "description": "時間の粒度。year=暦年、fiscal_year=年度（4月始まり）、month=月、day=日。zone は year/fiscal_year のみ意味を持つ",
          "enum": [
            "year",
            "fiscal_year",
            "month",
            "day",
          ],
          "type": "string",
        },
        "limit": {
          "description": "返す行数の上限（既定 100、最大 500）",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "scope": {
          "oneOf": [
            {
              "properties": {
                "name": {
                  "description": "水域名（describe_catalog what='waters'）",
                  "type": "string",
                },
                "type": {
                  "const": "water",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "name",
              ],
              "type": "object",
            },
            {
              "properties": {
                "siteId": {
                  "description": "地点 ID",
                  "type": "string",
                },
                "type": {
                  "const": "site",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "siteId",
              ],
              "type": "object",
            },
            {
              "properties": {
                "type": {
                  "const": "zone",
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
          ],
        },
        "stat": {
          "description": "非代表の統計量（p75/p90/max/min）。省略時は代表系列",
          "type": "string",
        },
        "to": {
          "description": "grain='day' の終了日 YYYY-MM-DD",
          "type": "string",
        },
        "variableId": {
          "description": "測定項目の ID（describe_catalog / search_registry で引く）",
          "type": "string",
        },
      },
      "required": [
        "variableId",
        "scope",
        "grain",
      ],
      "type": "object",
    },
    "name": "get_observations",
  },
  {
    "description": "生物の出現記録（GBIF・iNaturalist）の集計を取る。kind='species_catalog' は種の一覧（件数の多い順、group で分類群を絞る）、'species_years'/'species_months' は種ごとの年別・月別件数（binoms に学名）、'watershed_years' は流域ごとの年別件数。出現記録は観察努力量に偏るため、件数の増減を生息数の増減と読まない。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "binoms": {
          "description": "kind='species_years'/'species_months' の学名（最大 20）",
          "items": {
            "type": "string",
          },
          "maxItems": 20,
          "type": "array",
        },
        "group": {
          "description": "kind='species_catalog' の分類群（例: 鳥類）",
          "type": "string",
        },
        "kind": {
          "description": "集計の種類",
          "enum": [
            "species_catalog",
            "species_years",
            "species_months",
            "watershed_years",
          ],
          "type": "string",
        },
        "limit": {
          "description": "返す行数の上限（既定 100、最大 500）",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "placeId": {
          "description": "kind='watershed_years' の流域 place_id（省略時は全流域）",
          "type": "string",
        },
      },
      "required": [
        "kind",
      ],
      "type": "object",
    },
    "name": "get_occurrences",
  },
  {
    "description": "配布用データセット（dist/ の Parquet）の目録を返す。datapackage.json が指す各ファイルの相対パスと sha256 だけで、ファイルそのものは返さない（配信は別）。配布物が未配備のときは available=false と理由を返す。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "export_dataset",
  },
]
`;
