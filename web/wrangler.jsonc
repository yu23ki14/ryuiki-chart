{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryuiki-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // 流域カルテの全データを 1 つの D1 に入れる。
  // database_id は `wrangler d1 create ryuiki` が採番したもの（本番用）。
  // ローカル（miniflare）ではこの値は使われず、.wrangler/ 配下の SQLite を見る。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ryuiki",
      "database_id": "634bbe1b-72aa-48a0-9021-c15167f68a0b",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // 「広報たつごう」のベクトル検索（Issue #132、docs/plans/TATSUGO_KOHO_VECTOR.md §2・§6）。
  // Workers AI と Vectorize にローカルの模擬は無く、バインディングは実リソースへ接続する（remote: true）。
  // index_name は src/lib/vector/config.json の index_name と同じにする。インデックスは本番反映のときに
  // `wrangler vectorize create` で先に作る（無いと deploy が失敗する。手順は DEPLOYMENT.md）。
  // 画面・API・テストはバインディングが無い／接続できないときも動く（src/lib/vector/bindings.ts が無効扱いにする）。
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "ryuiki-koho-bgem3-v1", "remote": true }
  ],

  // /api/mcp のレート制限（値は src/lib/features.ts の MCP_RATE_LIMIT と揃える）。
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
